{
  "name": "sleekcode",
  "version": "1.0.1",
  "description": "LeetCode practice in your terminal, where you can print your way to a solution. NeetCode 150 in TypeScript or Python.",
  "private": true,
  "type": "module",
  "bin": {
    "sk": "src/cli.ts",
    "sleek": "src/cli.ts"
  },
  "scripts": {
    "build:cases": "bun build/build-cases.ts",
    "build:bank": "bun build/build-bank.ts",
    "validate": "bun build/validate.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@datastructures-js/priority-queue": "4",
    "@datastructures-js/queue": "4",
    "@types/bun": "^1.4.2",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
